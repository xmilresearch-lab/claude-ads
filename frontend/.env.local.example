# ============================================================
# AI Automation Platform — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend URL (used for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment name
# Options: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Web Push VAPID public key (must match VAPID_PUBLIC_KEY in backend .env)
# Generate via: see backend/.env.example for the generation command
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── SaaS Billing (Stripe) ────────────────────────────────────────────────────
# These are the Stripe Price IDs for each plan (not secret keys).
# Find them in Stripe Dashboard > Products.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_
