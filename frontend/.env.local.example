# ─── Backend API ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=           # Base URL for the backend REST API (e.g. http://localhost:8000/api/v1)
NEXT_PUBLIC_APP_NAME=          # App display name shown in the UI
NEXT_PUBLIC_ADMIN_DOMAIN=      # Admin subdomain prefix

# ─── Database (Prisma) ──────────────────────────────────────────────────────────
DATABASE_URL=                  # PostgreSQL connection string (postgresql+asyncpg://user:pass@host:5432/db)

# ─── Cache / Rate Limiting ──────────────────────────────────────────────────────
REDIS_URL=                     # Redis connection string (redis://localhost:6379/0)
UPSTASH_REDIS_REST_URL=        # Upstash Redis REST endpoint URL
UPSTASH_REDIS_REST_TOKEN=      # Upstash Redis REST authentication token

# ─── NextAuth ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=                  # Canonical URL of this Next.js app (e.g. http://localhost:3000)
NEXTAUTH_SECRET=               # Random secret used to sign JWTs and session cookies (openssl rand -hex 32)

# ─── Claude AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=             # Anthropic API key (sk-ant-...)
CLAUDE_MODEL=                  # Claude model to use (e.g. claude-sonnet-4-20250514)

# ─── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=                    # 256-bit hex secret key for JWT signing
ENCRYPTION_KEY=                # 256-bit hex key for AES-256-GCM credential encryption
JWT_ALGORITHM=                 # JWT signing algorithm (HS256)
ACCESS_TOKEN_EXPIRE_MINUTES=   # Access token lifetime in minutes (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=     # Refresh token lifetime in days (default: 30)

# ─── MCP Servers ────────────────────────────────────────────────────────────────
SOCIAL_MCP_URL=                # Social MCP server URL (http://localhost:3001)
EMAIL_MCP_URL=                 # Email MCP server URL (http://localhost:3002)
CRM_MCP_URL=                   # CRM MCP server URL (http://localhost:3003)
MCP_AUTH_TOKEN=                # Shared bearer token for all MCP servers

# ─── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=             # Stripe secret API key (sk_live_... or sk_test_...)
STRIPE_WEBHOOK_SECRET=         # Stripe webhook signing secret (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # Stripe publishable key (pk_live_... or pk_test_...)

# ─── Resend (Email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                # Resend API key for transactional email

# ─── Sentry ─────────────────────────────────────────────────────────────────────
SENTRY_DSN=                    # Sentry DSN for error tracking
SENTRY_ORG=                    # Sentry organization slug
SENTRY_PROJECT=                # Sentry project slug
NEXT_PUBLIC_SENTRY_DSN=        # Sentry DSN exposed to the browser

# ─── PostHog ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=       # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST=      # PostHog host URL (https://app.posthog.com)

# ─── OAuth Integration Credentials (app-level, stored encrypted in DB) ──────────
TWITTER_CLIENT_ID=             # Twitter OAuth2 client ID
TWITTER_CLIENT_SECRET=         # Twitter OAuth2 client secret
LINKEDIN_CLIENT_ID=            # LinkedIn OAuth2 client ID
LINKEDIN_CLIENT_SECRET=        # LinkedIn OAuth2 client secret
GOOGLE_CLIENT_ID=              # Google OAuth2 client ID
GOOGLE_CLIENT_SECRET=          # Google OAuth2 client secret
HUBSPOT_CLIENT_ID=             # HubSpot OAuth2 client ID
HUBSPOT_CLIENT_SECRET=         # HubSpot OAuth2 client secret
