# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

# Build-only system deps (gcc for C extensions, libpq-dev for psycopg2, curl for health probes)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install all Python dependencies into an isolated venv so the runtime
# stage gets a clean copy with no build tools or cache.
COPY pyproject.toml .
RUN python -m venv /build/venv \
    && /build/venv/bin/pip install --upgrade pip \
    && /build/venv/bin/pip install --no-cache-dir . \
    && /build/venv/bin/pip install --no-cache-dir uvloop httptools

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

# Non-root user for security — never run as root in production
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Runtime system deps only — no gcc or build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built venv and application code only
COPY --from=builder /build/venv /app/venv
COPY app/        /app/app/
COPY alembic/    /app/alembic/
COPY alembic.ini /app/
COPY main.py     /app/

# Activate venv via PATH; disable bytecode and buffering for clean logs
ENV PATH="/app/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Drop to non-root
USER appuser

EXPOSE 8000

# Container-level health check (also surfaced by orchestrators)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 4 Uvicorn workers, uvloop event loop, httptools HTTP parser for max throughput
CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--http", "httptools"]
