<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instagram MCP Evaluation Suite
  Server: social-mcp-server (port 3001)
  Tools: instagram_create_post, instagram_create_reel, instagram_get_media, instagram_get_media_insights
-->
<evals server="social-mcp-server" base_url="http://localhost:3001">

  <eval id="ig-01" read_only="true">
    <description>List recent Instagram posts</description>
    <system>You are a social media assistant. Use MCP tools to retrieve information.</system>
    <prompt>Show me my last 10 Instagram posts.</prompt>
    <expected_tools>
      <tool name="instagram_get_media">
        <arg name="limit" type="int">10</arg>
        <arg name="offset" type="int">0</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool_result JSON contains key "has_more"</pass_if>
      <pass_if>tool called with limit == 10</pass_if>
    </rubric>
  </eval>

  <eval id="ig-02" read_only="false">
    <description>Publish an image post to Instagram</description>
    <system>You are a social media assistant.</system>
    <prompt>Post this image to Instagram for workspace ws-001: https://cdn.example.com/photo.jpg with caption "Beautiful day outside!"</prompt>
    <expected_tools>
      <tool name="instagram_create_post">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="image_url" type="string">https://cdn.example.com/photo.jpg</arg>
        <arg name="caption" type="string">Beautiful day outside!</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "media_id"</pass_if>
      <pass_if>tool_result JSON contains key "permalink"</pass_if>
      <pass_if>tool_result JSON field "status" equals "published"</pass_if>
    </rubric>
  </eval>

  <eval id="ig-03" read_only="false">
    <description>Publish a Reel to Instagram</description>
    <system>You are a social media assistant.</system>
    <prompt>Upload this video as an Instagram Reel for workspace ws-001: https://cdn.example.com/reel.mp4, caption "Behind the scenes!"</prompt>
    <expected_tools>
      <tool name="instagram_create_reel">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_url" type="string">https://cdn.example.com/reel.mp4</arg>
        <arg name="caption" type="string">Behind the scenes!</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "media_id"</pass_if>
      <pass_if>tool_result JSON field "status" equals "published"</pass_if>
    </rubric>
  </eval>

  <eval id="ig-04" read_only="true">
    <description>Get media insights for a post</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>Get the insights for Instagram post 17846368219941196 in workspace ws-001.</prompt>
    <expected_tools>
      <tool name="instagram_get_media_insights">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="media_id" type="string">17846368219941196</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "media_id"</pass_if>
      <pass_if>tool_result JSON contains key "metrics"</pass_if>
    </rubric>
  </eval>

  <eval id="ig-05" read_only="true">
    <description>Get specific metrics for an Instagram post</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>For post 17846368219941196 in workspace ws-001, show only the reach and saved metrics.</prompt>
    <expected_tools>
      <tool name="instagram_get_media_insights">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="media_id" type="string">17846368219941196</arg>
        <arg name="metrics" type="array">["reach", "saved"]</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "metrics"</pass_if>
      <pass_if>tool called with metrics containing "reach"</pass_if>
      <pass_if>tool called with metrics containing "saved"</pass_if>
    </rubric>
  </eval>

  <eval id="ig-06" read_only="true">
    <description>List posts with restricted field selection</description>
    <system>You are a social media assistant.</system>
    <prompt>Show me only the id and permalink of my last 5 Instagram posts.</prompt>
    <expected_tools>
      <tool name="instagram_get_media">
        <arg name="limit" type="int">5</arg>
        <arg name="fields" type="string">id,permalink</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool called with limit == 5</pass_if>
      <pass_if>tool called with fields containing "permalink"</pass_if>
    </rubric>
  </eval>

  <eval id="ig-07" read_only="false">
    <description>Publish Reel with share_to_feed enabled</description>
    <system>You are a social media assistant.</system>
    <prompt>Post this Reel to workspace ws-001 and also share it to the main feed: https://cdn.example.com/video2.mp4, caption "Our new collection is here!"</prompt>
    <expected_tools>
      <tool name="instagram_create_reel">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_url" type="string">https://cdn.example.com/video2.mp4</arg>
        <arg name="share_to_feed" type="boolean">true</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "media_id"</pass_if>
      <pass_if>tool called with share_to_feed == true</pass_if>
    </rubric>
  </eval>

  <eval id="ig-08" read_only="true">
    <description>Multi-tool: list posts then get insights for most recent one</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>For workspace ws-001, list my recent Instagram posts and then get the insights for the most recent one.</prompt>
    <expected_tools>
      <tool name="instagram_get_media">
        <arg name="limit" type="int">1</arg>
      </tool>
      <tool name="instagram_get_media_insights">
        <arg name="workspace_id" type="string">ws-001</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>instagram_get_media is called first</pass_if>
      <pass_if>instagram_get_media_insights is called second</pass_if>
      <pass_if>insights tool uses media_id from media list result</pass_if>
    </rubric>
  </eval>

  <eval id="ig-09" read_only="true">
    <description>Paginated media listing — second page</description>
    <system>You are a social media assistant.</system>
    <prompt>Get the second page of my Instagram posts using 10 posts per page.</prompt>
    <expected_tools>
      <tool name="instagram_get_media">
        <arg name="limit" type="int">10</arg>
        <arg name="offset" type="int">10</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool called with offset >= 10</pass_if>
    </rubric>
  </eval>

  <eval id="ig-10" read_only="true">
    <description>Multi-tool: compare impressions of two posts</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>Compare the impressions of two Instagram posts (IDs: 17846368219941196 and 17846368219941197) in workspace ws-001 and tell me which performed better.</prompt>
    <expected_tools>
      <tool name="instagram_get_media_insights">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="media_id" type="string">17846368219941196</arg>
        <arg name="metrics" type="array">["impressions"]</arg>
      </tool>
      <tool name="instagram_get_media_insights">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="media_id" type="string">17846368219941197</arg>
        <arg name="metrics" type="array">["impressions"]</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>instagram_get_media_insights called twice with different media_ids</pass_if>
      <pass_if>both calls include impressions metric</pass_if>
      <pass_if>response compares the two values</pass_if>
    </rubric>
  </eval>

</evals>
