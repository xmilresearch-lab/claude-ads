<?xml version="1.0" encoding="UTF-8"?>
<!--
  Email MCP Server Evaluation Suite
  Server  : email-mcp-server  (port 3002)
  Protocol: MCP streamable-HTTP with Bearer auth

  Rules
  ─────
  • Only read-only tools are exercised (readOnlyHint=true).
    Excluded: email_send_message, email_send_campaign, support_create_ticket,
              support_reply_ticket
  • Every expected_tools entry maps 1-to-1 with a tool the model MUST invoke.
  • rubric criteria are evaluated by the runner against the raw tool-result JSON.
  • Multi-tool eval (id email-10) requires BOTH tool calls to appear in order.
-->
<evals server="email-mcp-server" base_url="http://localhost:3002">

  <!-- ── Gmail: email_list_messages ───────────────────────────────────────── -->

  <eval id="email-01" read_only="true">
    <description>List unread inbox messages</description>
    <system>You are an email assistant. Use the available MCP tools to retrieve email information. Do not send any emails.</system>
    <prompt>Show me my 10 most recent unread emails.</prompt>
    <expected_tools>
      <tool name="email_list_messages">
        <arg name="label" type="string">UNREAD</arg>
        <arg name="limit" type="int">10</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool_result JSON contains key "has_more"</pass_if>
      <pass_if>tool_result JSON contains key "total_count"</pass_if>
      <pass_if>tool called with label == "UNREAD"</pass_if>
    </rubric>
  </eval>

  <eval id="email-02" read_only="true">
    <description>Gmail search query filter</description>
    <system>You are an email assistant. Use the available MCP tools to retrieve email information. Do not send any emails.</system>
    <prompt>Find all emails from support@example.com in my inbox.</prompt>
    <expected_tools>
      <tool name="email_list_messages">
        <arg name="query" type="string">from:support@example.com</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool called with query containing "from:"</pass_if>
    </rubric>
  </eval>

  <eval id="email-03" read_only="true">
    <description>Inbox label filter with small limit</description>
    <system>You are an email assistant. Use the available MCP tools to retrieve email information. Do not send any emails.</system>
    <prompt>Show me the 5 most recent emails in my inbox.</prompt>
    <expected_tools>
      <tool name="email_list_messages">
        <arg name="label" type="string">INBOX</arg>
        <arg name="limit" type="int">5</arg>
        <arg name="offset" type="int">0</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool_result JSON contains key "total_count"</pass_if>
      <pass_if>tool called with limit == 5</pass_if>
    </rubric>
  </eval>

  <!-- ── Gmail: email_get_message ─────────────────────────────────────────── -->

  <eval id="email-04" read_only="true">
    <description>Fetch full content of a specific Gmail message</description>
    <system>You are an email assistant. Use the available MCP tools to retrieve email information. Do not send any emails.</system>
    <prompt>Get the full content of Gmail message with ID 17abc123def456.</prompt>
    <expected_tools>
      <tool name="email_get_message">
        <arg name="message_id" type="string">17abc123def456</arg>
        <arg name="format" type="string">full</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool called with message_id == "17abc123def456"</pass_if>
      <pass_if>tool called with format == "full"</pass_if>
    </rubric>
  </eval>

  <eval id="email-05" read_only="true">
    <description>Fetch metadata-only view of a Gmail message</description>
    <system>You are an email assistant. Use the available MCP tools to retrieve email information. Do not send any emails.</system>
    <prompt>Retrieve only the metadata (headers) for Gmail message ID abc456xyz789 — I don't need the full body.</prompt>
    <expected_tools>
      <tool name="email_get_message">
        <arg name="message_id" type="string">abc456xyz789</arg>
        <arg name="format" type="string">metadata</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool called with message_id == "abc456xyz789"</pass_if>
      <pass_if>tool called with format == "metadata"</pass_if>
    </rubric>
  </eval>

  <!-- ── Zendesk: support_list_tickets ────────────────────────────────────── -->

  <eval id="email-06" read_only="true">
    <description>List all open Zendesk support tickets</description>
    <system>You are a support operations assistant. Use the available MCP tools to retrieve support ticket information. Do not create or reply to tickets.</system>
    <prompt>Show me all open support tickets.</prompt>
    <expected_tools>
      <tool name="support_list_tickets">
        <arg name="status" type="string">open</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool_result JSON contains key "total_count"</pass_if>
      <pass_if>tool_result JSON contains key "has_more"</pass_if>
      <pass_if>tool called with status == "open"</pass_if>
    </rubric>
  </eval>

  <eval id="email-07" read_only="true">
    <description>List urgent tickets sorted by most recently updated</description>
    <system>You are a support operations assistant. Use the available MCP tools to retrieve support ticket information. Do not create or reply to tickets.</system>
    <prompt>Show me urgent support tickets, most recently updated first.</prompt>
    <expected_tools>
      <tool name="support_list_tickets">
        <arg name="status" type="string">urgent</arg>
        <arg name="sort_by" type="string">updated_at</arg>
        <arg name="sort_order" type="string">desc</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool called with status == "urgent"</pass_if>
      <pass_if>tool called with sort_by == "updated_at"</pass_if>
      <pass_if>tool called with sort_order == "desc"</pass_if>
    </rubric>
  </eval>

  <eval id="email-08" read_only="true">
    <description>List pending tickets sorted by priority</description>
    <system>You are a support operations assistant. Use the available MCP tools to retrieve support ticket information. Do not create or reply to tickets.</system>
    <prompt>List all pending tickets sorted by priority from highest to lowest.</prompt>
    <expected_tools>
      <tool name="support_list_tickets">
        <arg name="status" type="string">pending</arg>
        <arg name="sort_by" type="string">priority</arg>
        <arg name="sort_order" type="string">desc</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool called with status == "pending"</pass_if>
      <pass_if>tool called with sort_by == "priority"</pass_if>
    </rubric>
  </eval>

  <eval id="email-09" read_only="true">
    <description>Paginated ticket listing — second page of open tickets</description>
    <system>You are a support operations assistant. Use the available MCP tools to retrieve support ticket information. Do not create or reply to tickets.</system>
    <prompt>Get the second page of open support tickets using 25 tickets per page.</prompt>
    <expected_tools>
      <tool name="support_list_tickets">
        <arg name="status" type="string">open</arg>
        <arg name="limit" type="int">25</arg>
        <arg name="offset" type="int">25</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "items"</pass_if>
      <pass_if>tool_result JSON contains key "next_offset"</pass_if>
      <pass_if>tool called with offset >= 25</pass_if>
      <pass_if>tool called with limit == 25</pass_if>
    </rubric>
  </eval>

  <!-- ── Multi-tool: email_list_messages → email_get_message ──────────────── -->

  <eval id="email-10" read_only="true">
    <description>Sequential: list unread emails then fetch details of the first result</description>
    <system>You are an email assistant. Use the available MCP tools to retrieve email information. Do not send any emails.</system>
    <prompt>Find my most recent unread email and show me its full content.</prompt>
    <expected_tools>
      <tool name="email_list_messages">
        <arg name="label" type="string">UNREAD</arg>
        <arg name="limit" type="int">1</arg>
        <arg name="offset" type="int">0</arg>
      </tool>
      <tool name="email_get_message">
        <arg name="format" type="string">full</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>email_list_messages is called first</pass_if>
      <pass_if>email_get_message is called second</pass_if>
      <pass_if>email_get_message called with format == "full"</pass_if>
      <pass_if>email_list_messages tool_result JSON contains key "items"</pass_if>
    </rubric>
  </eval>

</evals>
