<?xml version="1.0" encoding="UTF-8"?>
<!--
  TikTok MCP Evaluation Suite
  Server: social-mcp-server (port 3001)
  Tools: tiktok_publish_video, tiktok_get_videos, tiktok_get_video_analytics
-->
<evals server="social-mcp-server" base_url="http://localhost:3001">

  <eval id="tt-01" read_only="true">
    <description>List recent TikTok videos</description>
    <system>You are a social media assistant. Use MCP tools to retrieve information.</system>
    <prompt>Show me the 10 most recent TikTok videos for workspace ws-001.</prompt>
    <expected_tools>
      <tool name="tiktok_get_videos">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="max_count" type="int">10</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "videos"</pass_if>
      <pass_if>tool_result JSON contains key "has_more"</pass_if>
      <pass_if>tool called with max_count == 10</pass_if>
    </rubric>
  </eval>

  <eval id="tt-02" read_only="false">
    <description>Publish a TikTok video from URL</description>
    <system>You are a social media assistant.</system>
    <prompt>Upload this video to TikTok for workspace ws-001: https://cdn.example.com/video.mp4, title "Check out our latest product demo!"</prompt>
    <expected_tools>
      <tool name="tiktok_publish_video">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_url" type="string">https://cdn.example.com/video.mp4</arg>
        <arg name="title" type="string">Check out our latest product demo!</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "publish_id"</pass_if>
      <pass_if>tool_result JSON field "status" equals "published"</pass_if>
    </rubric>
  </eval>

  <eval id="tt-03" read_only="true">
    <description>Get analytics for a specific TikTok video</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>Get the analytics for TikTok video 7123456789012345678 in workspace ws-001.</prompt>
    <expected_tools>
      <tool name="tiktok_get_video_analytics">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_id" type="string">7123456789012345678</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "video_id"</pass_if>
      <pass_if>tool_result JSON contains key "view_count"</pass_if>
      <pass_if>tool_result JSON contains key "like_count"</pass_if>
    </rubric>
  </eval>

  <eval id="tt-04" read_only="true">
    <description>List videos with pagination cursor</description>
    <system>You are a social media assistant.</system>
    <prompt>Get the next page of TikTok videos for workspace ws-001 using cursor 1680000000.</prompt>
    <expected_tools>
      <tool name="tiktok_get_videos">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="cursor" type="int">1680000000</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "videos"</pass_if>
      <pass_if>tool_result JSON contains key "cursor"</pass_if>
      <pass_if>tool called with cursor present</pass_if>
    </rubric>
  </eval>

  <eval id="tt-05" read_only="false">
    <description>Publish video with followers-only privacy</description>
    <system>You are a social media assistant.</system>
    <prompt>Post this TikTok video for workspace ws-001 visible only to followers: https://cdn.example.com/teaser.mp4, title "Exclusive sneak peek"</prompt>
    <expected_tools>
      <tool name="tiktok_publish_video">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_url" type="string">https://cdn.example.com/teaser.mp4</arg>
        <arg name="privacy_level" type="string">FOLLOWER_OF_CREATOR</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "publish_id"</pass_if>
      <pass_if>tool called with privacy_level == "FOLLOWER_OF_CREATOR"</pass_if>
    </rubric>
  </eval>

  <eval id="tt-06" read_only="false">
    <description>Publish video with comments disabled</description>
    <system>You are a social media assistant.</system>
    <prompt>Post this video to TikTok for workspace ws-001 with comments turned off: https://cdn.example.com/promo.mp4, title "New product drop"</prompt>
    <expected_tools>
      <tool name="tiktok_publish_video">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_url" type="string">https://cdn.example.com/promo.mp4</arg>
        <arg name="title" type="string">New product drop</arg>
        <arg name="disable_comment" type="boolean">true</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "publish_id"</pass_if>
      <pass_if>tool called with disable_comment == true</pass_if>
    </rubric>
  </eval>

  <eval id="tt-07" read_only="true">
    <description>Get comment and share counts for a video</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>For workspace ws-001, what are the total comments and shares on TikTok video 7123456789012345678?</prompt>
    <expected_tools>
      <tool name="tiktok_get_video_analytics">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_id" type="string">7123456789012345678</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "comment_count"</pass_if>
      <pass_if>tool_result JSON contains key "share_count"</pass_if>
    </rubric>
  </eval>

  <eval id="tt-08" read_only="true">
    <description>List videos with small page size</description>
    <system>You are a social media assistant.</system>
    <prompt>Fetch just the last 3 TikTok videos for workspace ws-001.</prompt>
    <expected_tools>
      <tool name="tiktok_get_videos">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="max_count" type="int">3</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tool_result JSON contains key "videos"</pass_if>
      <pass_if>tool called with max_count == 3</pass_if>
    </rubric>
  </eval>

  <eval id="tt-09" read_only="true">
    <description>Multi-tool: list videos then get analytics for first video</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>For workspace ws-001, list the most recent TikTok video then get its full analytics.</prompt>
    <expected_tools>
      <tool name="tiktok_get_videos">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="max_count" type="int">1</arg>
      </tool>
      <tool name="tiktok_get_video_analytics">
        <arg name="workspace_id" type="string">ws-001</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tiktok_get_videos is called first</pass_if>
      <pass_if>tiktok_get_video_analytics is called second</pass_if>
      <pass_if>analytics tool uses video_id from videos list</pass_if>
    </rubric>
  </eval>

  <eval id="tt-10" read_only="true">
    <description>Multi-tool: compare view counts of two videos</description>
    <system>You are a social media analytics assistant.</system>
    <prompt>For workspace ws-001, compare the view counts of TikTok videos 7123456789012345678 and 7123456789012345679. Which got more views?</prompt>
    <expected_tools>
      <tool name="tiktok_get_video_analytics">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_id" type="string">7123456789012345678</arg>
      </tool>
      <tool name="tiktok_get_video_analytics">
        <arg name="workspace_id" type="string">ws-001</arg>
        <arg name="video_id" type="string">7123456789012345679</arg>
      </tool>
    </expected_tools>
    <rubric>
      <pass_if>tiktok_get_video_analytics called twice with different video_ids</pass_if>
      <pass_if>both results contain view_count</pass_if>
      <pass_if>response names the video with higher view_count</pass_if>
    </rubric>
  </eval>

</evals>
