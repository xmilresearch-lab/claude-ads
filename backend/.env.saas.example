# =============================================
# SaaS Layer — Additional Environment Variables
# =============================================
# These supplement backend/.env.example for the public SaaS deployment.
# NEVER reference XMiL's DATABASE_URL or ENCRYPTION_KEY here.
# Create a separate Railway project for the SaaS instance.

# Database (separate from XMiL deployment — generate fresh)
DATABASE_URL=postgresql+asyncpg://user:pass@your-railway-db:5432/saas_db

# New secrets — NEVER reuse XMiL keys
SECRET_KEY=<new-random-256-bit-hex>
ENCRYPTION_KEY=<new-random-256-bit-hex>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# App URLs
APP_URL=https://app.yoursaas.com
MARKETING_URL=https://yoursaas.com

# Monthly Anthropic API budget alert threshold (USD)
MONTHLY_BUDGET_THRESHOLD=500.00

# VAPID (generate fresh pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@yoursaas.com
