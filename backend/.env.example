# Application
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/automation

# Redis
REDIS_URL=redis://localhost:6379/0

# Weaviate
WEAVIATE_URL=http://localhost:8080

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Encryption key — base64-encoded 32 random bytes
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Social integrations
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Email integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENDGRID_API_KEY=
ZENDESK_SUBDOMAIN=
ZENDESK_API_TOKEN=

# CRM integrations
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# MCP Servers (bearer tokens generated at startup)
SOCIAL_MCP_URL=http://localhost:3001
SOCIAL_MCP_TOKEN=
EMAIL_MCP_URL=http://localhost:3002
EMAIL_MCP_TOKEN=
CRM_MCP_URL=http://localhost:3003
CRM_MCP_TOKEN=

# Rate limits per workspace per day
RATE_LIMIT_SOCIAL_POSTS=50
RATE_LIMIT_EMAILS_SENT=1000
RATE_LIMIT_AI_CALLS=500
RATE_LIMIT_CRM_UPDATES=2000
