{
  "name": "sales-team",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prompts": "npx tsx lib/systemPromptAudit.ts",
    "audit:ai-security": "npx tsx scripts/aiSecurityAudit.ts",
    "scan:setup": "bash security/scanner/setup.sh",
    "scan:static": "security/scanner/venv/bin/python security/scanner/static/run_static.py",
    "scan:adversarial": "vitest run security/scanner/adversarial/",
    "scan:adversarial:watch": "vitest security/scanner/adversarial/",
    "scan:live": "security/scanner/venv/bin/python security/scanner/live/run_garak.py",
    "scan:live:localhost": "security/scanner/venv/bin/python security/scanner/live/run_garak.py --target http://localhost:3000",
    "scanner:create-test-user": "npx tsx scripts/create-scanner-test-user.ts",
    "scan:all": "cd security/scanner && bash scan_all.sh",
    "scan:all:upload": "cd security/scanner && bash scan_all.sh --upload"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.56.0",
    "@stripe/stripe-js": "^9.7.0",
    "@upstash/qstash": "^2.11.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/og": "^0.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "next-pwa": "^5.6.0",
    "pg": "^8.21.0",
    "posthog-js": "^1.380.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.5.0",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
